{
    "name": "collab-client-vue",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "dev:local": "vite --config vite.config.local.ts",
        "build:local": "vite build --config vite.config.local.ts",
        "pretypecheck:local": "node ../../scripts/check-local-survey.mjs",
        "typecheck:local": "vue-tsc -p tsconfig.local.json --noEmit"
    },
    "dependencies": {
        "vue": "^3.4.19",
        "survey-core": "^3.0.1",
        "survey-vue3-ui": "^3.0.1",
        "survey-creator-core": "^3.0.1",
        "survey-creator-vue": "^3.0.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.4",
        "typescript": "^5.5.4",
        "vite": "^5.4.2",
        "vue-tsc": "^2.0.29"
    }
}
