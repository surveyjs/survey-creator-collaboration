{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            // survey-react-ui declares @types/react as a peer, and in the :local mode
            // the sibling build sits next to its own copy; pin every react type
            // reference to this app's single one.
            "react": ["./node_modules/@types/react"],
            "react-dom": ["./node_modules/@types/react-dom"]
        }
    },
    "include": ["src", "vite.config.ts", "../../shared"]
}
