{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "projects": {
        "angular": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "dist",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "baseHref": "/angular/",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "styles": [
                            "node_modules/survey-core/survey-core.css",
                            "node_modules/survey-creator-core/survey-creator-core.css",
                            "node_modules/survey-creator-core/collaboration.css"
                        ],
                        "budgets": [
                            { "type": "initial", "maximumWarning": "10mb", "maximumError": "20mb" }
                        ],
                        "outputHashing": "all"
                    },
                    "configurations": {
                        "production": { "optimization": true },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "local": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "tsConfig": "tsconfig.local.json",
                            "styles": [
                                "../../../survey-library/packages/survey-core/build/survey-core.css",
                                "../../../survey-creator/packages/survey-creator-core/build/survey-creator-core.css",
                                "../../../survey-creator/packages/survey-creator-core/build/collaboration.css"
                            ]
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": { "port": 5176 },
                    "configurations": {
                        "production": { "buildTarget": "angular:build:production" },
                        "development": { "buildTarget": "angular:build:development" },
                        "local": { "buildTarget": "angular:build:local" }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    },
    "cli": {
      "analytics": false
    }
}
