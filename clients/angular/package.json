{
    "name": "collab-client-angular",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "prestart": "node scripts/gen-license-key.mjs",
        "start": "ng serve --proxy-config proxy.conf.json",
        "prebuild": "node scripts/gen-license-key.mjs",
        "build": "ng build",
        "typecheck": "ng build --configuration development --no-progress",
        "prestart:local": "node ../../scripts/check-local-survey.mjs && node scripts/gen-license-key.mjs",
        "start:local": "ng serve --configuration local --proxy-config proxy.conf.json",
        "prebuild:local": "node ../../scripts/check-local-survey.mjs && node scripts/gen-license-key.mjs",
        "build:local": "ng build --configuration local"
    },
    "dependencies": {
        "@angular/animations": "^18.2.0",
        "@angular/cdk": "^18.2.0",
        "@angular/common": "^18.2.0",
        "@angular/compiler": "^18.2.0",
        "@angular/core": "^18.2.0",
        "@angular/forms": "^18.2.0",
        "@angular/platform-browser": "^18.2.0",
        "@angular/platform-browser-dynamic": "^18.2.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.6.0",
        "zone.js": "~0.14.10",
        "survey-core": "^3.0.1",
        "survey-angular-ui": "^3.0.1",
        "survey-creator-core": "^3.0.1",
        "survey-creator-angular": "^3.0.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^18.2.0",
        "@angular/cli": "^18.2.0",
        "typescript": "~5.5.4"
    }
}
