# Copy to .env (gitignored). Read at BUILD time by all four clients:
# Vite clients via envDir, the Angular client via scripts/gen-license-key.mjs.
# A variable set in the real environment (e.g. docker compose) wins over .env.
SURVEYJS_LICENSE_KEY=

# Only for `npm run dev:*:local` / `build:*:local`: where the survey-library and
# survey-creator checkouts live, if they are not right next to this repo.
# Absolute, or relative to the repo root. Same variable as in theme-adapter-demos.
# SURVEYJS_LIBV3=../surveyjs
